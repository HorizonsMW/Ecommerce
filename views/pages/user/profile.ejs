// 🚪 Logout Handler (matches your logout controller)
logoutBtn?.addEventListener('click', async () => {
    if (!confirm('Are you sure you want to logout?')) return;
    
    try {
        // Call your backend logout endpoint
        await fetch('http://localhost:5000/api/user/logout', {
            method: 'GET',
            credentials: 'include' // 🍪 Send refreshToken cookie  
        });
    } catch (err) {
        console.warn('Backend logout call failed, clearing local storage anyway:', err);
    } finally {
        // Clear local storage regardless
        localStorage.removeItem('jwtToken');
        sessionStorage.removeItem('jwtToken');
        localStorage.removeItem('user');
        sessionStorage.removeItem('user');
        // Redirect to login
        window.location.href = '/user/login';
    }
});

// 🔐 Change Password Placeholder
document.getElementById('changePasswordBtn')?.addEventListener('click', () => {
    showMessage('🚧 Change password feature coming soon!', 'success');
});

// 🎨 Initialize avatar initials on load
document.addEventListener('DOMContentLoaded', () => {
    // EJS already renders initial values, but sync with stored user if available
    const stored = localStorage.getItem('user') || sessionStorage.getItem('user');
    if (stored) {
        try {
            const user = JSON.parse(stored);
            if (user.firstname && user.lastname) {
                document.getElementById('avatarInitials').textContent = 
                    `${user.firstname[0]}${user.lastname[0]}`.toUpperCase();
            }
        } catch (e) {
            // Fallback to EJS-rendered values
        }
    }
});
