<% if (typeof user==='undefined' || !user) { %>
    <script>
        // 🔐 Redirect if no user data (server-side guard)
        window.location.href = '/user/login';
    </script>
    <% } %>

        <section class="profile-section">
            <div class="container">
                <!-- Header with Welcome & Logout -->
                <div class="profile-header">
                    <button id="homeBtn" class="cta-button cta-secondary">
                        <a href="/" class="link-primary"
                            style="display: inline-flex; align-items: center; gap: 0.25rem; text-decoration: none;">
                            ← Back to Home
                        </a>
                    </button>
                    <div>
                        <h2 class="section-title">My Profile</h2>
                        <p class="section-subtitle">Manage your account settings and preferences</p>
                    </div>
                    <button id="logoutBtn" class="cta-button cta-secondary">
                        <span>🚪</span> Logout
                    </button>
                </div>

                <!-- Error/Success Messages -->
                <div id="messageBox" class="message-box" style="display: none;"></div>

                <!-- Profile Content Grid -->
                <div class="profile-grid">
                    <!-- Left Column: Profile Card -->
                    <div class="profile-card">
                        <div class="profile-avatar">
                            <span class="avatar-initials" id="avatarInitials">
                                <%= user.firstname?.[0] || 'U' %>
                                    <%= user.lastname?.[0] || 'S' %>
                            </span>
                            <% if (user.isAdmin) { %>
                                <span class="admin-badge" title="Administrator">👑 Admin</span>
                                <% } %>
                        </div>

                        <div class="profile-info">
                            <h3 class="profile-name" id="displayName">
                                <%= user.firstname %>
                                    <%= user.lastname %>
                            </h3>
                            <p class="profile-email" id="displayEmail">
                                <%= user.email %>
                            </p>
                            <p class="profile-mobile" id="displayMobile">
                                📱 <%= user.mobile || 'Not provided' %>
                            </p>

                            <div class="profile-meta">
                                <span class="meta-item">
                                    <strong>Member since:</strong>
                                    <span id="memberSince">
                                        <%= new Date(user.createdAt || Date.now()).toLocaleDateString() %>
                                    </span>
                                </span>
                                <span class="meta-item">
                                    <strong>Account status:</strong>
                                    <span class="status-badge status-<%= user.isBlocked ? 'blocked' : 'active' %>">
                                        <%= user.isBlocked ? 'Blocked' : 'Active' %>
                                    </span>
                                </span>
                                <!-- In profile-meta div -->
                                <span class="meta-item">
                                    <strong>Last updated:</strong>
                                    <span id="lastUpdated">
                                        <%= new Date(user.updatedAt || user.createdAt).toLocaleString() %>
                                    </span>
                                </span>
                            </div>
                        </div>

                        <button id="editProfileBtn" class="cta-button" style="width: 100%; margin-top: 1rem;">
                            ✏️ Edit Profile
                        </button>
                    </div>

                    <!-- Right Column: Edit Form (Hidden by Default) -->
                    <div id="editFormCard" class="profile-card edit-form-card" style="display: none;">
                        <h4 class="form-title">Update Your Information</h4>

                        <form id="editProfileForm" class="login-form">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="editFirstname" class="form-label">First Name</label>
                                    <input type="text" id="editFirstname" class="input-field"
                                        value="<%= user.firstname %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="editLastname" class="form-label">Last Name</label>
                                    <input type="text" id="editLastname" class="input-field"
                                        value="<%= user.lastname %>" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="editEmail" class="form-label">Email Address</label>
                                <input type="email" id="editEmail" class="input-field" value="<%= user.email %>"
                                    required>
                                <small class="form-hint">Email changes may require verification</small>
                            </div>

                            <div class="form-group">
                                <label for="editMobile" class="form-label">Mobile Number</label>
                                <input type="tel" id="editMobile" class="input-field" value="<%= user.mobile || '' %>"
                                    placeholder="+1234567890">
                            </div>

                            <div class="form-actions">
                                <button type="button" id="cancelEditBtn" class="cta-button cta-secondary">
                                    Cancel
                                </button>
                                <button type="submit" class="cta-button" id="saveBtn">
                                    <span class="btn-text">Save Changes</span>
                                    <span class="btn-loader" style="display: none;">Saving...</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Security Section (Full Width) -->
                    <div class="profile-card security-section">
                        <h4 class="form-title">🔐 Security Settings</h4>

                        <div class="security-item">
                            <div>
                                <strong>Password</strong>
                                <p class="text-secondary">Last changed: <span id="passwordLastChanged">Never</span></p>
                            </div>
                            <button class="cta-button cta-secondary" id="changePasswordBtn">
                                Change Password
                            </button>
                        </div>

                        <div class="security-item">
                            <div>
                                <strong>Active Sessions</strong>
                                <p class="text-secondary">Manage devices logged into your account</p>
                            </div>
                            <button class="cta-button cta-secondary">
                                View Sessions
                            </button>
                            <div>
                                <strong>Two-Factor Authentication</strong>
                                <p class="text-secondary">Add an extra layer of security</p>
                            </div>
                            <label class="toggle-switch">
                                <input type="checkbox" id="twoFactorToggle">
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <% if (user.isAdmin) { %>
                            <div class="security-item admin-only">
                                <div>
                                    <strong>⚙️ Admin Access</strong>
                                    <p class="text-secondary">You have administrator privileges</p>
                                </div>
                                <a href="/admin/dashboard" class="cta-button">
                                    Go to Dashboard →
                                </a>
                            </div>
                            <% } %>
                    </div>
                    <!-- Addresses Section (Full Width) -->
                    <div class="profile-card addresses-section">
                        <div class="addresses-header">
                            <h4 class="form-title">📍 Saved Addresses</h4>
                            <button class="cta-button cta-secondary" id="addAddressBtn"
                                style="padding: 0.5rem 1rem; font-size: 0.9rem;">
                                + Add New Address
                            </button>
                        </div>

                        <!-- Empty State -->
                        <div id="noAddresses" class="empty-addresses"
                            style="display: none; text-align: center; padding: 2rem; color: var(--text-secondary);">
                            <p>You haven't saved any addresses yet.</p>
                            <p style="font-size: 0.9rem; margin-top: 0.5rem;">Add an address for faster checkout.</p>
                        </div>

                        <!-- Addresses List -->
                        <div id="addressesList" class="addresses-list">
                            <!-- Addresses will be rendered here by addresses.js -->
                        </div>
                    </div>

                    <!-- Add/Edit Address Modal -->
                    <div id="addressModal" class="modal-overlay" style="display: none;">
                        <div class="modal-card">
                            <div class="modal-header">
                                <h4 class="modal-title" id="addressModalTitle">Add New Address</h4>
                                <button class="modal-close" id="closeAddressModal" aria-label="Close">&times;</button>
                            </div>

                            <div class="modal-body">
                                <form id="addressForm">
                                    <input type="hidden" id="addressId">

                                    <div class="form-row"
                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                        <div>
                                            <label class="form-label" for="addressLabel">Label (e.g., Home,
                                                Work)</label>
                                            <input type="text" id="addressLabel" class="input-field" placeholder="Home"
                                                required>
                                        </div>
                                        <div>
                                            <label class="form-label" for="addressName">Full Name</label>
                                            <input type="text" id="addressName" class="input-field"
                                                placeholder="John Doe" required>
                                        </div>
                                    </div>

                                    <div class="form-group" style="margin-top: 1rem;">
                                        <label class="form-label" for="addressLine1">Address Line 1</label>
                                        <input type="text" id="addressLine1" class="input-field"
                                            placeholder="123 Main St" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label" for="addressLine2">Address Line 2 (Optional)</label>
                                        <input type="text" id="addressLine2" class="input-field" placeholder="Apt 4B">
                                    </div>

                                    <div class="form-row"
                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                                        <div>
                                            <label class="form-label" for="addressCity">City</label>
                                            <input type="text" id="addressCity" class="input-field"
                                                placeholder="New York" required>
                                        </div>
                                        <div>
                                            <label class="form-label" for="addressState">State/Province</label>
                                            <input type="text" id="addressState" class="input-field" placeholder="NY"
                                                required>
                                        </div>
                                    </div>

                                    <div class="form-row"
                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                                        <div>
                                            <label class="form-label" for="addressPostal">Postal Code</label>
                                            <input type="text" id="addressPostal" class="input-field"
                                                placeholder="10001" required>
                                        </div>
                                        <div>
                                            <label class="form-label" for="addressCountry">Country</label>
                                            <input type="text" id="addressCountry" class="input-field"
                                                placeholder="United States" required>
                                        </div>
                                    </div>

                                    <div class="form-group" style="margin-top: 1rem;">
                                        <label class="form-label" for="addressPhone">Phone Number</label>
                                        <input type="tel" id="addressPhone" class="input-field"
                                            placeholder="+1 234 567 8900" required>
                                    </div>

                                    <div class="form-options" style="margin-top: 1.5rem;">
                                        <label class="remember-me">
                                            <input type="checkbox" id="addressDefault">
                                            <span>Set as default address</span>
                                        </label>
                                    </div>
                                </form>
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="cta-button cta-secondary" id="cancelAddressModal">
                                    Cancel
                                </button>
                                <button type="button" class="cta-button" id="saveAddressBtn">
                                    <span class="btn-text">Save Address</span>
                                    <span class="btn-loader" style="display: none;">Saving...</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Password Verification Modal -->
            <div id="passwordModal" class="modal-overlay" style="display: none;">
                <div class="modal-card">
                    <div class="modal-header">
                        <h4 class="modal-title">🔐 Confirm Your Identity</h4>
                        <button class="modal-close" id="closePasswordModal" aria-label="Close">&times;</button>
                    </div>

                    <div class="modal-body">
                        <p class="modal-description">
                            For security, please enter your password to confirm these changes.
                        </p>

                        <div id="passwordError" class="error-message" style="display: none;"></div>

                        <div class="form-group">
                            <label for="verifyPassword" class="form-label">Current Password</label>
                            <div class="password-wrapper">
                                <input type="password" id="verifyPassword" name="password" class="input-field" required
                                    placeholder="••••••••" autocomplete="current-password">
                                <!-- Toggle button positioned by CSS (.password-wrapper + .toggle-password) -->
                                <button type="button" class="toggle-password" id="toggleVerifyPassword"
                                    aria-label="Toggle password visibility">
                                    👁️
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="cta-button cta-secondary" id="cancelPasswordVerify">
                            Cancel
                        </button>
                        <button type="button" class="cta-button" id="confirmPasswordVerify">
                            <span class="btn-text">Confirm & Save</span>
                            <span class="btn-loader" style="display: none;">Verifying...</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- JavaScript: Profile Logic (Fixed API URLs + DOM Ready) -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // 🔐 Auth helper - gets token for API calls
                const getAuthHeaders = () => {
                    const token = localStorage.getItem('jwtToken') || sessionStorage.getItem('jwtToken');
                    return {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        ...(token && { 'Authorization': `Bearer ${token}` })
                    };
                };

                // ✅ Dynamic API base - server runs on PORT 4000
                const API_BASE = `http://${window.location.hostname}:4000/api`;

                // 📦 API helper
                const api = {
                    request: async (url, options = {}) => {
                        const response = await fetch(url, {
                            credentials: 'include', // 🍪 Send cookies
                            headers: getAuthHeaders(),
                            ...options
                        });

                        if (response.status === 401) {
                            // Token expired/invalid → redirect to login
                            localStorage.removeItem('jwtToken');
                            sessionStorage.removeItem('jwtToken');
                            localStorage.removeItem('user');
                            sessionStorage.removeItem('user');
                            window.location.href = '/user/login?redirect=' + encodeURIComponent(window.location.pathname);
                            return null;
                        }

                        if (!response.ok) {
                            const err = await response.json().catch(() => ({}));
                            throw new Error(err.message || `HTTP ${response.status}`);
                        }

                        return response.json();
                    },
                    get: (url) => api.request(url, { method: 'GET' }),
                    put: (url, body) => api.request(url, { method: 'PUT', body: JSON.stringify(body) })
                };

                // 🎯 Show message helper
                const showMessage = (text, type = 'error') => {
                    const box = document.getElementById('messageBox');
                    if (!box) return;
                    box.textContent = text;
                    box.className = `message-box ${type}`;
                    box.style.display = 'block';

                    // Auto-hide success messages
                    if (type === 'success') {
                        setTimeout(() => {
                            box.style.display = 'none';
                        }, 4000);
                    }
                };

                // 🔄 DOM Elements (ensure they exist)
                const editProfileBtn = document.getElementById('editProfileBtn');
                const editFormCard = document.getElementById('editFormCard');
                const cancelEditBtn = document.getElementById('cancelEditBtn');
                const editForm = document.getElementById('editProfileForm');
                const saveBtn = document.getElementById('saveBtn');
                const logoutBtn = document.getElementById('logoutBtn');
                const passwordModal = document.getElementById('passwordModal');
                const closePasswordModal = document.getElementById('closePasswordModal');
                const cancelPasswordVerify = document.getElementById('cancelPasswordVerify');
                const confirmPasswordVerify = document.getElementById('confirmPasswordVerify');
                const verifyPasswordInput = document.getElementById('verifyPassword');
                const toggleVerifyPassword = document.getElementById('toggleVerifyPassword');
                const passwordError = document.getElementById('passwordError');

                // Store pending update data
                let pendingUpdateData = null;

                // ✏️ Toggle Edit Mode
                if (editProfileBtn && editFormCard) {
                    editProfileBtn.addEventListener('click', () => {
                        editFormCard.style.display = 'block';
                        editProfileBtn.style.display = 'none';
                        // Scroll to form on mobile
                        if (window.innerWidth < 768) {
                            editFormCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    });
                }

                if (cancelEditBtn && editFormCard && editProfileBtn) {
                    cancelEditBtn.addEventListener('click', () => {
                        // Reset form to original values from EJS-rendered user
                        const firstnameEl = document.getElementById('editFirstname');
                        const lastnameEl = document.getElementById('editLastname');
                        const emailEl = document.getElementById('editEmail');
                        const mobileEl = document.getElementById('editMobile');

                        if (firstnameEl) firstnameEl.value = `<%= user.firstname %>`;
                        if (lastnameEl) lastnameEl.value = `<%= user.lastname %>`;
                        if (emailEl) emailEl.value = `<%= user.email %>`;
                        if (mobileEl) mobileEl.value = `<%= user.mobile || '' %>`;

                        if (editForm) editForm.reset();
                        editFormCard.style.display = 'none';
                        editProfileBtn.style.display = 'flex';
                        const msgBox = document.getElementById('messageBox');
                        if (msgBox) msgBox.style.display = 'none';
                    });
                }

                // 🔐 Show Password Verification Modal
                const showPasswordModal = (pendingData) => {
                    pendingUpdateData = pendingData;
                    if (passwordError) passwordError.style.display = 'none';
                    if (verifyPasswordInput) {
                        verifyPasswordInput.value = '';
                        verifyPasswordInput.focus();
                    }
                    if (passwordModal) {passwordModal.style.display = 'flex';}
                };

                // 🔐 Hide Password Verification Modal
                const hidePasswordModal = () => {
                    if (passwordModal) passwordModal.style.display = 'none';
                    document.body.style.overflow = '';
                    pendingUpdateData = null;
                };

                // Modal Close Handlers
                if (closePasswordModal) closePasswordModal.addEventListener('click', hidePasswordModal);
                if (cancelPasswordVerify) cancelPasswordVerify.addEventListener('click', hidePasswordModal);

                // Close modal when clicking outside
                if (passwordModal) {
                    passwordModal.addEventListener('click', (e) => {
                        if (e.target === passwordModal) {
                            hidePasswordModal();
                        }
                    });
                }

                // ✅ Toggle password visibility in modal (FIXED)
                if (toggleVerifyPassword && verifyPasswordInput) {
                    toggleVerifyPassword.addEventListener('click', function () {
                        const isPassword = verifyPasswordInput.type === 'password';
                        verifyPasswordInput.type = isPassword ? 'text' : 'password';
                        this.textContent = isPassword ? '🙈' : '👁️';
                        this.setAttribute(
                            'aria-label',
                            isPassword ? 'Hide password' : 'Show password',
                        );
                    });
                }

                // Handle Enter key in password field
                if (verifyPasswordInput && confirmPasswordVerify) {
                    verifyPasswordInput.addEventListener('keypress', (e) => {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            confirmPasswordVerify.click();
                        }
                    });
                }

                // 💾 Save Profile Changes WITH Password Verification
                if (editForm) {
                    editForm.addEventListener('submit', (e) => {
                        e.preventDefault();

                        // Collect updated data
                        const updatedData = {
                            firstname: document.getElementById('editFirstname')?.value.trim(),
                            lastname: document.getElementById('editLastname')?.value.trim(),
                            email: document.getElementById('editEmail')?.value.trim(),
                            mobile: document.getElementById('editMobile')?.value.trim()
                        };

                        // Show password verification modal before proceeding
                        showPasswordModal(updatedData);
                    });
                }

                // ✅ Confirm Password & Proceed with Update
                if (confirmPasswordVerify) {
                    confirmPasswordVerify.addEventListener('click', async () => {
                        const password = verifyPasswordInput?.value;
                        const btnText = confirmPasswordVerify.querySelector('.btn-text');
                        const btnLoader = confirmPasswordVerify.querySelector('.btn-loader');

                        if (!password) {
                            if (passwordError) {
                                passwordError.textContent = 'Please enter your password';
                                passwordError.style.display = 'block';
                            }
                            return;
                        }

                        // Loading state
                        confirmPasswordVerify.disabled = true;
                        if (btnText) btnText.style.display = 'none';
                        if (btnLoader) btnLoader.style.display = 'inline';
                        if (passwordError) passwordError.style.display = 'none';

                        try {
                            // 🔐 Step 1: Verify password via API (FIXED URL: port 4000)
                            const verifyResponse = await fetch(`${API_BASE}/user/verify-password`, {
                                method: 'POST',
                                headers: getAuthHeaders(),
                                credentials: 'include',
                                body: JSON.stringify({ password })
                            });

                            const verifyResult = await verifyResponse.json();

                            if (!verifyResponse.ok) {
                                throw new Error(verifyResult.message || 'Password verification failed');
                            }

                            // ✅ Password verified - proceed with profile update (FIXED URL)
                            const updatedUser = await api.put(`${API_BASE}/user/edit-user`, pendingUpdateData);

                            // Update UI with new values
                            const displayName = document.getElementById('displayName');
                            const displayEmail = document.getElementById('displayEmail');
                            const displayMobile = document.getElementById('displayMobile');
                            const avatarInitials = document.getElementById('avatarInitials');

                            if (displayName && updatedUser.firstname && updatedUser.lastname) {
                                displayName.textContent = `${updatedUser.firstname} ${updatedUser.lastname}`;
                            }
                            if (displayEmail && updatedUser.email) {
                                displayEmail.textContent = updatedUser.email;
                            }
                            if (displayMobile) {
                                displayMobile.textContent = `📱 ${updatedUser.mobile || 'Not provided'}`;
                            }
                            if (avatarInitials && updatedUser.firstname && updatedUser.lastname) {
                                avatarInitials.textContent = `${updatedUser.firstname[0]}${updatedUser.lastname[0]}`.toUpperCase();
                            }

                            // Update stored user data
                            const storedUser = {
                                _id: updatedUser._id,
                                firstname: updatedUser.firstname,
                                lastname: updatedUser.lastname,
                                email: updatedUser.email,
                                mobile: updatedUser.mobile,
                                isAdmin: updatedUser.isAdmin
                            };

                            if (localStorage.getItem('jwtToken')) {
                                localStorage.setItem('user', JSON.stringify(storedUser));
                            } else {
                                sessionStorage.setItem('user', JSON.stringify(storedUser));
                            }

                            // Hide modal & show success
                            hidePasswordModal();
                            showMessage('✅ Profile updated successfully!', 'success');

                            // Hide edit form after successful save
                            setTimeout(() => {
                                if (editFormCard) editFormCard.style.display = 'none';
                                if (editProfileBtn) editProfileBtn.style.display = 'flex';
                            }, 1000);

                        } catch (error) {
                            console.error('Update error:', error);
                            if (passwordError) {
                                passwordError.textContent = error.message || 'Verification failed. Please try again.';
                                passwordError.style.display = 'block';
                            }
                            if (verifyPasswordInput) verifyPasswordInput.focus();
                        } finally {
                            // Reset button
                            confirmPasswordVerify.disabled = false;
                            if (btnText) btnText.style.display = 'inline';
                            if (btnLoader) btnLoader.style.display = 'none';
                        }
                    });
                }

                // 🚪 Logout Handler (FIXED URL: port 4000)
                if (logoutBtn) {
                    logoutBtn.addEventListener('click', async () => {
                        if (!confirm('Are you sure you want to logout?')) return;

                        try {
                            // Call your backend logout endpoint
                            await fetch(`${API_BASE}/user/logout`, {
                                method: 'GET',
                                credentials: 'include' // 🍪 Send refreshToken cookie  
                            });
                        } catch (err) {
                            console.warn('Backend logout call failed, clearing local storage anyway:', err);
                        } finally {
                            // Clear local storage regardless
                            localStorage.removeItem('jwtToken');
                            sessionStorage.removeItem('jwtToken');
                            localStorage.removeItem('user');
                            sessionStorage.removeItem('user');
                            // Redirect to login
                            window.location.href = '/user/login';
                        }
                    });
                }

                // 🔐 Change Password Placeholder
                const changePasswordBtn = document.getElementById('changePasswordBtn');
                if (changePasswordBtn) {
                    changePasswordBtn.addEventListener('click', () => {
                        showMessage('🚧 Change password feature coming soon!', 'success');
                    });
                }

                // 🎨 Initialize avatar initials on load
                const stored = localStorage.getItem('user') || sessionStorage.getItem('user');
                if (stored) {
                    try {
                        const user = JSON.parse(stored);
                        const avatarInitials = document.getElementById('avatarInitials');
                        if (user.firstname && user.lastname && avatarInitials) {
                            avatarInitials.textContent =
                                `${user.firstname[0]}${user.lastname[0]}`.toUpperCase();
                        }
                    } catch (e) {
                        // Fallback to EJS-rendered values
                    }
                }
            });
        </script>