data/
mongodb/
*.mdb
*.lock

# Uploaded files (product images, user uploads)
uploads/
public/uploads/
images/uploads/
*.tmp
*.temp

# ========================================
# LOGS & CACHE
# ========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Cache directories
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.cache



# ========================================
# MISCELLANEOUS
# ========================================
# Temporary files
tmp/
temp/
*.tmp
*.temp

# Backup files
*.bak
*.backup
*.old


# Optional npm cache directory
.npm


# Optional lock file for yarn
yarn.lock

